# === Claude API (wajib untuk fitur generate) ===
# Buat di https://platform.claude.com -> API Keys
ANTHROPIC_API_KEY=

# Model penulis utas. Default claude-opus-5-5.
# Mau lebih hemat? ganti ke claude-sonnet-5-5 atau claude-haiku-5-5.
CLAUDE_MODEL=claude-opus-5-5

# === Threads API (wajib untuk login & posting sungguhan) ===
# Buat app di https://developers.facebook.com -> use case "Access the Threads API"
# Izin yang dipakai: threads_basic, threads_content_publish
THREADS_APP_ID=
THREADS_APP_SECRET=

# Alamat publik web ini (HARUS https saat production).
# Daftarkan {BASE_URL}/auth/threads/callback sebagai Redirect Callback URL di app Threads.
BASE_URL=http://localhost:3000

PORT=3000
# Zona waktu untuk jadwal Autopilot
TIMEZONE=Asia/Jakarta

# Kunci untuk tanda tangan cookie & enkripsi token. Kosongkan = dibuat otomatis di data/secret.
SESSION_SECRET=

# 1 = paksa mode demo (tanpa Threads API, posting hanya simulasi)
DEMO_MODE=
